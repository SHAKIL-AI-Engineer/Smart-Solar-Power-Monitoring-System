# Next.js server-side proxy target (set before building Next.js).
API_URL=http://127.0.0.1:5080
# API options are environment variables in the API process:
# ASPNETCORE_ENVIRONMENT=Development
# ALLOW_DEMO_LOGIN=true
# ConnectionStrings__Sqlite=Data Source=data/solar.db
# ConnectionStrings__SqlServer=Server=localhost;Database=SolarEms;User Id=sa;Password=...;TrustServerCertificate=true
